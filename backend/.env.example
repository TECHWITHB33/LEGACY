# Database
DATABASE_URL=sqlite:///data/id_card_system.db
LOG_LEVEL=info

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# JWT Secret (use 32-byte random string)
JWT_SECRET=your-super-secret-key-change-this-in-production

# JWT Expiry (in seconds)
JWT_EXPIRY=3600

# ==================== STELLAR PAYMENT CONFIGURATION ====================
# IMPORTANT: All keys MUST be in environment variables only. NEVER commit keys!
# IMPORTANT: Testnet only - Do NOT use mainnet in production

# Stellar Network Configuration (TESTNET ONLY)
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Stellar Account Keys (testnet only - NEVER commit these!)
# WARNING: These are placeholders. Generate real testnet keys at:
# https://stellar.expert/setup or use: soroban keys generate <name>
# NEVER put actual keys in version control!
STELLAR_MASTER_SECRET_KEY=SBYTES64HEXSTRING_FOR_TESTNET_ONLY_DO_NOT_USE_IN_PRODUCTION

# Merchant Account Keys (if you need pre-configured merchant accounts)
# Generate separate keys for each merchant in production
STELLAR_MERCHANT_SECRET_KEY=SBYTES64HEXSTRING_FOR_MERCHANT_TESTNET_ONLY

# Payment Configuration
PAYMENT_REQUEST_EXPIRY_HOURS=1
PAYMENT_MIN_AMOUNT=0.1
PAYMENT_MAX_AMOUNT=1000.0
TRANSACTION_TIMEOUT_SECONDS=30
TRANSACTION_RETRY_ATTEMPTS=3

# ==================== END STELLAR CONFIGURATION ====================

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Key derivation
PBKDF2_ITERATIONS=100000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Feature Flags
ENABLE_BIOMETRIC_AUTH=true
ENABLE_STELLAR_PAYMENTS=true
ENABLE_QR_VERIFICATION=true
ENABLE_AUDIT_LOGGING=true
